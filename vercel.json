{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/listings",
      "destination": "/for-sale/",
      "permanent": true
    },
    {
      "source": "/listings/",
      "destination": "/for-sale/",
      "permanent": true
    },
    {
      "source": "/commercial",
      "destination": "/downtown-los-angeles-commercial/",
      "permanent": true
    },
    {
      "source": "/commercial/",
      "destination": "/downtown-los-angeles-commercial/",
      "permanent": true
    },
    {
      "source": "/commercial/1048-s-los-angeles-st",
      "destination": "/downtown-los-angeles-commercial/1048-s-los-angeles-st/",
      "permanent": true
    },
    {
      "source": "/commercial/1048-s-los-angeles-st/",
      "destination": "/downtown-los-angeles-commercial/1048-s-los-angeles-st/",
      "permanent": true
    }
  ]
}